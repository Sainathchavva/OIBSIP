<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#101114"
    tools:context=".MainActivity">

    <!-- ==============================
         Calculator Display
         ============================== -->

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="14dp"
        android:background="#1B1D22"
        android:gravity="center_vertical|end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:maxLines="2"
        android:ellipsize="start"
        android:includeFontPadding="false"
        tools:text="125 + 25" />

    <!-- ==============================
         Calculator Grid
         ============================== -->

    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <!-- =================================
             ROW 1
             ================================= -->

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="C"
            android:textSize="20sp"
            android:textStyle="bold"
            android:contentDescription="Clear calculator" />

        <Button
            android:id="@+id/buttonBackspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="⌫"
            android:textSize="20sp"
            android:contentDescription="Backspace" />

        <Button
            android:id="@+id/buttonDivide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="÷"
            android:textSize="20sp"
            android:contentDescription="Divide" />

        <Button
            android:id="@+id/buttonMultiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="×"
            android:textSize="20sp"
            android:contentDescription="Multiply" />

        <!-- =================================
             ROW 2
             ================================= -->

        <Button
            android:id="@+id/button7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="7"
            android:textSize="20sp"
            android:contentDescription="Seven" />

        <Button
            android:id="@+id/button8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="8"
            android:textSize="20sp"
            android:contentDescription="Eight" />

        <Button
            android:id="@+id/button9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="9"
            android:textSize="20sp"
            android:contentDescription="Nine" />

        <Button
            android:id="@+id/buttonSubtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="−"
            android:textSize="20sp"
            android:contentDescription="Subtract" />

        <!-- =================================
             ROW 3
             ================================= -->

        <Button
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="4"
            android:textSize="20sp"
            android:contentDescription="Four" />

        <Button
            android:id="@+id/button5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="5"
            android:textSize="20sp"
            android:contentDescription="Five" />

        <Button
            android:id="@+id/button6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="6"
            android:textSize="20sp"
            android:contentDescription="Six" />

        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="+"
            android:textSize="20sp"
            android:contentDescription="Add" />

        <!-- =================================
             ROW 4
             ================================= -->

        <Button
            android:id="@+id/button1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="1"
            android:textSize="20sp"
            android:contentDescription="One" />

        <Button
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="2"
            android:textSize="20sp"
            android:contentDescription="Two" />

        <Button
            android:id="@+id/button3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="3"
            android:textSize="20sp"
            android:contentDescription="Three" />

        <Button
            android:id="@+id/buttonEquals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="="
            android:textSize="20sp"
            android:textStyle="bold"
            android:contentDescription="Equals" />

        <!-- =================================
             ROW 5
             ================================= -->

        <Button
            android:id="@+id/button0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="0"
            android:textSize="20sp"
            android:contentDescription="Zero" />

        <Button
            android:id="@+id/buttonDecimal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="."
            android:textSize="20sp"
            android:contentDescription="Decimal point" />

        <!-- Empty Grid Cell -->

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

    </GridLayout>

</LinearLayout>